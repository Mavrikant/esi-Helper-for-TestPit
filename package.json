{
  "name": "esi-helper-for-testpit",
  "displayName": "esi Helper for TestPit",
  "description": "Provides syntax highlighting, validation, and code snippets for esi files used in the TestPit tool.",
  "icon": "images/TestPitIcon.ico",
  "version": "0.2.8",
  "publisher": "karamandev",
  "repository": "https://github.com/Mavrikant/esi-Helper-for-TestPit",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:esi",
    "onCommand:extension.openWithTestPit",
    "onCommand:extension.updateStepNumbers",
    "onCommand:extension.refactorDocument",
    "onCommand:extension.runValidityCheck",
    "onCommand:extension.showProcessedFile",
    "onCommand:extension.serdAI",
    "onCommand:extension.gotoStep",
    "onCommand:extension.selectProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "myOutputContainer",
          "title": "SERDAI",
          "icon": "media/myIcon.svg"
        }
      ]
    },
    "views": {
      "myOutputContainer": [
        {
          "type": "webview",
          "id": "myOutputView",
          "name": "SERDAI"
        }
      ]
    },
    "languages": [
      {
        "id": "esi",
        "extensions": [
          ".esi"
        ],
        "aliases": [
          "ESI",
          "esi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "esi",
        "scopeName": "source.esi",
        "path": "./syntaxes/esi.json"
      }
    ],
    "snippets": [
      {
        "language": "esi",
        "path": "./snippets.json"
      }
    ],
    "commands": [
      {
        "command": "extension.openWithTestPit",
        "title": "Open with TestPit",
        "category": "ESI Helper"
      },
      {
        "command": "extension.updateStepNumbers",
        "title": "Update Step Numbers",
        "category": "ESI Helper"
      },
      {
        "command": "extension.refactorDocument",
        "title": "Refactor Document",
        "category": "ESI Helper"
      },
      {
        "command": "extension.runValidityCheck",
        "title": "Run Validity Check",
        "category": "ESI Helper"
      },
      {
        "command": "extension.showProcessedFile",
        "title": "Show Processed File",
        "category": "ESI Helper"
      },
      {
        "command": "extension.serdAI",
        "title": "Chat with SerdAI",
        "category": "ESI Helper"
      },
      {
        "command": "extension.generateStepDocumentation",
        "title": "Generate Step Documentation",
        "category": "ESI Helper"
      },
      {
        "command": "extension.selectProject",
        "title": "Select Project Preset",
        "category": "ESI Helper"
      }
    ],
    "keybindings": [
      {
        "command": "extension.gotoStep",
        "key": "ctrl+g",
        "mac": "cmd+g",
        "when": "editorLangId == esi"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.generateStepDocumentation",
          "when": "editorLangId == 'plaintext' && resourceExtname == '.esi'",
          "group": "esiHelper"
        }
      ]
    },
    "configuration": {
      "title": "esi Helper for TestPit",
      "properties": {
        "esihelper.refactorDocumentOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Refactor document on save by cleaning whitespaces and turning tabs to spaces."
        },
        "esihelper.activeProject": {
          "type": "string",
          "default": "RNE",
          "description": "Name of the currently active project preset."
        },
        "esihelper.projects": {
          "type": "array",
          "description": "List of project presets. Each preset defines the TestPit config folder and XML file names for a project.",
          "items": {
            "type": "object",
            "required": ["name", "configFolderPath"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name for the project preset."
              },
              "configFolderPath": {
                "type": "string",
                "description": "Path to the folder containing the TestPit config XML files."
              },
              "messageConfigFile": {
                "type": "string",
                "description": "Name of the message config XML file (e.g. MessageConfig_RNESystemTestCable.xml)."
              },
              "a429File": {
                "type": "string",
                "description": "Name of the A429 message fields XML file."
              },
              "m1553File": {
                "type": "string",
                "description": "Name of the 1553 message fields XML file."
              },
              "discreteFile": {
                "type": "string",
                "description": "Name of the discrete signals XML file."
              },
              "memoryPortsFile": {
                "type": "string",
                "description": "Name of the memory ports XML file."
              }
            }
          },
          "default": [
            {
              "name": "RNE",
              "configFolderPath": "D:\\RNE\\product_library\\tools\\TestPit\\Config\\",
              "messageConfigFile": "MessageConfig_RNESystemTestCable.xml",
              "a429File": "A429MessageFields.xml",
              "m1553File": "1553MessageFields.xml",
              "discreteFile": "DiscreteSignals.xml",
              "memoryPortsFile": "MemoryPorts.xml"
            },
            {
              "name": "VORILS",
              "configFolderPath": "D:\\VORILS\\product_library\\tools\\TestPit\\Config\\",
              "messageConfigFile": "MessageConfig_VORILSSystemTestCable.xml",
              "a429File": "A429MessageFields.xml",
              "m1553File": "1553MessageFields.xml",
              "discreteFile": "DiscreteSignals.xml",
              "memoryPortsFile": "MemoryPorts.xml"
            }
          ]
        },
        "esihelper.geminiApiKey": {
          "type": "string",
          "default": "AIzaSyBqg0Zo3XVh2Xohh4TABtqi1D4u9cY80A4",
          "description": "API key for Google Gemini AI"
        },
        "esihelper.geminiModelName": {
          "type": "string",
          "default": "gemini-2.0-flash-lite",
          "description": "Model name to use for Gemini AI"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint . --ext .ts,.tsx",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.18.125",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^5.19.0",
    "@typescript-eslint/parser": "^5.19.0",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.13.0",
    "mocha": "^11.1.0",
    "typescript": "^5.7.3",
    "vscode": "^1.1.37"
  },
  "dependencies": {
    "@google/generative-ai": "^0.23.0"
  },
  "overrides": {
    "minimatch": "3.0.5",
    "minimist": "1.2.8",
    "mkdirp": "2.1.3"
  }
}
