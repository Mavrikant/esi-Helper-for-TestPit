{
  "name": "esi-helper-for-testpit",
  "displayName": "esi Helper for TestPit",
  "description": "Provides syntax highlighting, validation, and code snippets for esi files used in the TestPit tool.",
  "icon": "images/TestPitIcon.ico",
  "version": "0.4.6",
  "publisher": "karamandev",
  "repository": "https://github.com/Mavrikant/esi-Helper-for-TestPit",
  "engines": {
    "vscode": "^1.144.0",
    "node": ">=22.0.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:esi",
    "onCommand:extension.openWithTestPit",
    "onCommand:extension.updateStepNumbers",
    "onCommand:extension.refactorDocument",
    "onCommand:extension.runValidityCheck",
    "onCommand:extension.showProcessedFile",
    "onCommand:extension.gotoStep",
    "onCommand:extension.selectProfile",
    "onCommand:extension.reloadRegistry",
    "onCommand:extension.pickExecutable",
    "onCommand:extension.showValidationInfo",
    "onCommand:extension.gotoMatchingTag"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "esi",
        "extensions": [
          ".esi"
        ],
        "aliases": [
          "ESI",
          "esi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "esi",
        "scopeName": "source.esi",
        "path": "./syntaxes/esi.json"
      }
    ],
    "snippets": [
      {
        "language": "esi",
        "path": "./snippets.json"
      }
    ],
    "commands": [
      {
        "command": "extension.openWithTestPit",
        "title": "Open with TestPit",
        "category": "ESI Helper"
      },
      {
        "command": "extension.updateStepNumbers",
        "title": "Update Step Numbers",
        "category": "ESI Helper"
      },
      {
        "command": "extension.refactorDocument",
        "title": "Refactor Document",
        "category": "ESI Helper"
      },
      {
        "command": "extension.runValidityCheck",
        "title": "Run Validity Check",
        "category": "ESI Helper"
      },
      {
        "command": "extension.showProcessedFile",
        "title": "Show Processed File",
        "category": "ESI Helper"
      },
      {
        "command": "extension.gotoStep",
        "title": "Go to Step",
        "category": "ESI Helper"
      },
      {
        "command": "extension.selectProfile",
        "title": "Select TestPit Profile",
        "category": "ESI Helper"
      },
      {
        "command": "extension.reloadRegistry",
        "title": "Reload TestPit Settings",
        "category": "ESI Helper"
      },
      {
        "command": "extension.pickExecutable",
        "title": "Pick TestPit Executable",
        "category": "ESI Helper"
      },
      {
        "command": "extension.showValidationInfo",
        "title": "Show Component Validation Info",
        "category": "ESI Helper"
      },
      {
        "command": "extension.gotoMatchingTag",
        "title": "Go to Matching Tag",
        "category": "ESI Helper"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extension.gotoStep",
          "when": "editorLangId == esi"
        },
        {
          "command": "extension.gotoMatchingTag",
          "when": "editorLangId == esi"
        }
      ]
    },
    "keybindings": [
      {
        "command": "extension.gotoStep",
        "key": "ctrl+g",
        "mac": "cmd+g",
        "when": "editorLangId == esi"
      },
      {
        "command": "extension.gotoMatchingTag",
        "key": "ctrl+shift+\\",
        "mac": "cmd+shift+\\",
        "when": "editorTextFocus && editorLangId == esi"
      }
    ],
    "configuration": {
      "title": "esi Helper for TestPit",
      "properties": {
        "esihelper.refactorDocumentOnSave": {
          "type": "boolean",
          "scope": "machine",
          "default": false,
          "description": "Refactor document on save by cleaning whitespaces and turning tabs to spaces. User-scoped only — cannot be set per workspace."
        },
        "esihelper.alignmentScope": {
          "type": "string",
          "enum": [
            "section",
            "tier"
          ],
          "enumDescriptions": [
            "Align '=' within each section independently, to that section's longest field name.",
            "Align '=' across all sections at the same bracket-depth, to the longest field name at that depth."
          ],
          "scope": "machine",
          "default": "section",
          "description": "How field '=' signs are aligned when formatting .esi files (Format Document, or save when refactorDocumentOnSave is on). User-scoped only — cannot be set per workspace."
        },
        "esihelper.inlayHints.enumNames": {
          "type": "boolean",
          "default": true,
          "description": "Show the enum name after a numeric value assigned to a field that has an enum table in the active profile's XML config."
        },
        "esihelper.inlayHints.units": {
          "type": "boolean",
          "default": true,
          "description": "Show the unit declared in the active profile's XML config after a numeric field value."
        },
        "esihelper.inlayHints.ranges": {
          "type": "boolean",
          "default": false,
          "description": "Show the MinValue..MaxValue range declared in the active profile's XML config after a numeric field value."
        }
      }
    },
    "configurationDefaults": {
      "[esi]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.linkedEditing": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "class:esi": {
            "foreground": "#4BC8AF",
            "italic": true
          },
          "class.defaultLibrary:esi": {
            "foreground": "#4BC8AF",
            "italic": false
          },
          "property:esi": {
            "foreground": "#FA8072",
            "italic": true
          },
          "property.defaultLibrary:esi": {
            "foreground": "#FA8072",
            "italic": false
          },
          "enumMember:esi": {
            "foreground": "#F0E04A",
            "italic": true
          },
          "enumMember.defaultLibrary:esi": {
            "foreground": "#F0E04A",
            "italic": false
          },
          "keyword:esi": "#569CD6",
          "*.deprecated:esi": {
            "strikethrough": true
          }
        },
        "[Default Light Modern][Light Modern][Default Light+][Light+][Light 2026][Visual Studio Light][Quiet Light][Solarized Light][Default High Contrast Light]": {
          "rules": {
            "class:esi": {
              "foreground": "#0B6E60",
              "italic": true
            },
            "class.defaultLibrary:esi": {
              "foreground": "#0B6E60",
              "italic": false
            },
            "property:esi": {
              "foreground": "#B0321E",
              "italic": true
            },
            "property.defaultLibrary:esi": {
              "foreground": "#B0321E",
              "italic": false
            },
            "enumMember:esi": {
              "foreground": "#735C00",
              "italic": true
            },
            "enumMember.defaultLibrary:esi": {
              "foreground": "#735C00",
              "italic": false
            },
            "keyword:esi": "#0B5CAD",
            "*.deprecated:esi": {
              "strikethrough": true
            }
          }
        }
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "source.esi",
            "settings": {
              "foreground": "#CCCCCC"
            }
          },
          {
            "scope": "comment.line.number-sign.esi",
            "settings": {
              "foreground": "#6A9955"
            }
          },
          {
            "scope": "entity.name.tag.esi",
            "settings": {
              "foreground": "#4BC8AF"
            }
          },
          {
            "scope": "entity.name.tag.section.esi",
            "settings": {
              "foreground": "#4BC8AF",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "entity.name.tag.step.esi",
            "settings": {
              "foreground": "#FF79C6",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "punctuation.definition.tag.close.esi",
            "settings": {
              "foreground": "#9DA5B4"
            }
          },
          {
            "scope": "keyword.other.field.esi",
            "settings": {
              "foreground": "#569CD6"
            }
          },
          {
            "scope": "variable.other.macro.esi",
            "settings": {
              "foreground": "#E5C07B"
            }
          },
          {
            "scope": "string.other.path.esi",
            "settings": {
              "foreground": "#D2B1FA"
            }
          },
          {
            "scope": "string.quoted.double.esi",
            "settings": {
              "foreground": "#D8A0AE"
            }
          },
          {
            "scope": "constant.language.esi",
            "settings": {
              "foreground": "#66FFFF"
            }
          },
          {
            "scope": "constant.numeric.esi",
            "settings": {
              "foreground": "#66FFFF"
            }
          },
          {
            "scope": "keyword.other.unit.esi",
            "settings": {
              "foreground": "#9CDCFE"
            }
          },
          {
            "scope": "keyword.operator.comparison.esi",
            "settings": {
              "foreground": "#A6E22E"
            }
          },
          {
            "scope": "meta.tag.markup.esi",
            "settings": {
              "foreground": "#B0926C"
            }
          },
          {
            "scope": "keyword.other.csv-ref.esi",
            "settings": {
              "foreground": "#B392F0"
            }
          }
        ],
        "[Default Light Modern][Light Modern][Default Light+][Light+][Light 2026][Visual Studio Light][Quiet Light][Solarized Light][Default High Contrast Light]": {
          "textMateRules": [
            {
              "scope": "source.esi",
              "settings": {
                "foreground": "#333333"
              }
            },
            {
              "scope": "comment.line.number-sign.esi",
              "settings": {
                "foreground": "#3F6F2F"
              }
            },
            {
              "scope": "entity.name.tag.esi",
              "settings": {
                "foreground": "#0B6E60"
              }
            },
            {
              "scope": "entity.name.tag.section.esi",
              "settings": {
                "foreground": "#0B6E60",
                "fontStyle": "bold"
              }
            },
            {
              "scope": "entity.name.tag.step.esi",
              "settings": {
                "foreground": "#A3158F",
                "fontStyle": "bold"
              }
            },
            {
              "scope": "punctuation.definition.tag.close.esi",
              "settings": {
                "foreground": "#5A6472"
              }
            },
            {
              "scope": "keyword.other.field.esi",
              "settings": {
                "foreground": "#0B5CAD"
              }
            },
            {
              "scope": "variable.other.macro.esi",
              "settings": {
                "foreground": "#7A5200"
              }
            },
            {
              "scope": "string.other.path.esi",
              "settings": {
                "foreground": "#6F42C1"
              }
            },
            {
              "scope": "string.quoted.double.esi",
              "settings": {
                "foreground": "#A3335B"
              }
            },
            {
              "scope": "constant.language.esi",
              "settings": {
                "foreground": "#00697A"
              }
            },
            {
              "scope": "constant.numeric.esi",
              "settings": {
                "foreground": "#00697A"
              }
            },
            {
              "scope": "keyword.other.unit.esi",
              "settings": {
                "foreground": "#2A6485"
              }
            },
            {
              "scope": "keyword.operator.comparison.esi",
              "settings": {
                "foreground": "#456E0E"
              }
            },
            {
              "scope": "meta.tag.markup.esi",
              "settings": {
                "foreground": "#775A3C"
              }
            },
            {
              "scope": "keyword.other.csv-ref.esi",
              "settings": {
                "foreground": "#5B3FA8"
              }
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint . --ext .ts,.tsx",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "mocha --require ./test/setup.js",
    "coverage": "c8 npm test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.144.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vscode/test-electron": "^3.1.0",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "mock-require": "^3.0.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  },
  "c8": {
    "exclude": [
      "src/lib/xmlIndex.ts"
    ]
  }
}
